#  Please refer to the wiki(https://github.com/nlef/moonraker-telegram-bot/wiki) for detailed information on how to configure the bot

[bot]
server: localhost
bot_token: REDACTED
chat_id: REDACTED
# debug: true              # verbose log to printer_data/logs/telegram.log — the
                           # timelapse guard messages name the exact frame blocker

[camera]
host: http://localhost:8080/?action=stream
type: mjpeg

#[progress_notification]
#percent: 5
#height: 5
#time: 600

[timelapse]
cleanup: true
#height: 0.2
time: 2
target_fps: 30
min_lapse_duration: 5
max_lapse_duration: 60
manual_mode: true
# manual_mode is REQUIRED on the plotter: Klipper's print_stats.print_duration
# is tied to extruder filament tracking and stays 0 on an extruderless machine,
# so the bot's auto mode never takes a single frame (guard: "lapse must not run
# with auto mode and zero print duration"). In manual mode the lapse is driven
# from the exported G-code instead:
#   startG:  RESPOND PREFIX=timelapse MSG=start   (raises _running; the time
#                                                  interval above then fires)
#   endG:    RESPOND PREFIX=timelapse MSG=stop
#            RESPOND PREFIX=timelapse MSG=create  (render + send to Telegram;
#                                                  minutes on a Pi 4)
# See MUUSIA-PLOTTER-MECH-HANDOFF.md section 8.
