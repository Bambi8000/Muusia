[Unit]
Description=TM1637 DRO displays (Moonraker work coordinates)
After=network.target moonraker.service
Wants=moonraker.service

[Service]
Type=simple
User=nakit
WorkingDirectory=/home/nakit/dro-service
ExecStart=/usr/bin/python3 /home/nakit/dro-service/dro_tm1637.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
